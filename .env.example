# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.

# --- Database (PostgreSQL, via Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glow_hub?schema=public"
# If this points at a connection pooler (Neon/Supabase pooled endpoints,
# PgBouncer, etc): Prisma Migrate's advisory locks commonly break through
# transaction poolers. This Prisma version's prisma.config.ts datasource
# doesn't support a separate directUrl, so run `prisma migrate`/`db seed`
# with DATABASE_URL temporarily swapped to the unpooled connection string,
# then switch back to the pooled one for the running app.

# --- Cache / session (Redis) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Random 32+ byte secret used to sign JWTs / session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# --- Payments ---
# Paystack confirmed as the payment provider (see docs/decisions.md). Wired
# for real in Phase 5.
PAYMENT_PROVIDER="paystack"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# --- SMS provider (Termii or Africa's Talking — confirm choice with founder) ---
SMS_PROVIDER="termii"
TERMII_API_KEY=""
# AFRICAS_TALKING_API_KEY=""
# AFRICAS_TALKING_USERNAME=""

# --- Transactional email provider ---
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="Glow Hub <no-reply@glowhub.example.com>"

# --- Object storage (product images, dispatch proof photos) ---
OBJECT_STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Error logging ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
