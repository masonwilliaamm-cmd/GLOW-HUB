// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Reference schema: docs/build-plan.md §2 (Core Data Entities).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  VENDOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  vendorProfile  VendorProfile?
  ordersAsBuyer  Order[]        @relation("BuyerOrders")
  disputesRaised Dispute[]
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrustTier {
  READY_STOCK
  MADE_TO_ORDER
}

model VendorProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  businessName         String
  verificationStatus   VerificationStatus @default(PENDING)
  trustTier            TrustTier
  payoutAccountDetails String
  createdAt            DateTime           @default(now())

  products                Product[]
  orders                  Order[]
  payouts                 Payout[]
  dispatchProofsSubmitted DispatchProof[]
}

enum ProductCategory {
  SKINCARE
  MAKEUP
  HAIR
  FASHION
  SHOES
  ACCESSORIES
  FRAGRANCE
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
}

model Product {
  id          String          @id @default(cuid())
  vendorId    String
  vendor      VendorProfile   @relation(fields: [vendorId], references: [id])
  title       String
  category    ProductCategory
  description String
  price       Decimal         @db.Decimal(12, 2)
  images      String[]
  stockStatus StockStatus     @default(IN_STOCK)
  isActive    Boolean         @default(true)

  orders Order[]
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_ESCROW
  DISPATCHED
  DELIVERED
  DISPUTED
  RELEASED
  REFUNDED
}

model Order {
  id          String        @id @default(cuid())
  buyerId     String
  buyer       User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id])
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Int
  totalAmount Decimal       @db.Decimal(12, 2)

  // Nullable rather than required: added in Phase 4, after Phase 1 had
  // already seeded Order rows without this data. Always populated by the
  // checkout flow going forward.
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  contactPhone    String?

  status    OrderStatus @default(PENDING_PAYMENT)
  createdAt DateTime    @default(now())

  escrowTransaction EscrowTransaction?
  dispatchProofs    DispatchProof[]
  disputes          Dispute[]
  payouts           Payout[]

  @@index([status])
  @@index([vendorId])
  @@index([buyerId])
}

enum EscrowStatus {
  HELD
  PARTIALLY_RELEASED
  FULLY_RELEASED
  REFUNDED
}

model EscrowTransaction {
  id                          String       @id @default(cuid())
  orderId                     String       @unique
  order                       Order        @relation(fields: [orderId], references: [id])
  amountHeld                  Decimal      @db.Decimal(12, 2)
  amountReleasedToVendor      Decimal      @default(0) @db.Decimal(12, 2)
  releasePercentageOnDispatch Int
  status                      EscrowStatus @default(HELD)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
}

model DispatchProof {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  courierName   String
  waybillNumber String
  proofImageUrl String?
  submittedById String
  submittedBy   VendorProfile @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime      @default(now())
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_VENDOR
}

model Dispute {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id])
  raisedById String
  raisedBy   User          @relation(fields: [raisedById], references: [id])
  reason     String
  status     DisputeStatus @default(OPEN)
  adminNotes String?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Payout {
  id               String        @id @default(cuid())
  vendorId         String
  vendor           VendorProfile @relation(fields: [vendorId], references: [id])
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id])
  amount           Decimal       @db.Decimal(12, 2)
  status           PayoutStatus  @default(PENDING)
  paymentReference String?
  createdAt        DateTime      @default(now())
}
